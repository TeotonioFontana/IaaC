{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyOutsideUsEast1ExceptListed",
      "Effect": "Deny",
      "NotAction": [
        "ec2:Describe*",
        "ec2:Get*",
        "ec2:CreateSnapshot",
        "ec2:CreateTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": { "aws:RequestedRegion": "us-east-1" }
      }
    }
  ]
}
