{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowListForPrefixes",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::212533511020-tf-iaac",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "tf-backup/runs/*",
            "tf-backup/archives/*",
            "tf-backup/index/*"
          ]
        }
      }
    },
    {
      "Sid": "AllowPutToRunScopedArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts",
        "s3:PutObjectTagging"
      ],
      "Resource": [
        "arn:aws:s3:::212533511020-tf-iaac/tf-backup/runs/*",
        "arn:aws:s3:::212533511020-tf-iaac/tf-backup/archives/*",
        "arn:aws:s3:::212533511020-tf-iaac/tf-backup/index/*"
      ]
    }
  ]
}
