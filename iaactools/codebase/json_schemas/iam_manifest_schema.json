{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iaac-recovery-suite/json_schemas/iam_manifest_schema.json",
  "title": "IAM Manifest Schema",
  "description": "Dedicated IAM dump for large environments. Referenced from account_manifest.json.",
  "$comment": "Introduced in v1.1.0 to avoid losing IAM detail when account_manifest.json must stay small.",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "string", "default": "1.1.0" },
        "generated_at": { "type": "string", "format": "date-time" },
        "source_account": { "type": ["string", "null"] }
      },
      "required": ["schema_version"]
    },

    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "UserName": { "type": "string" },
          "Arn": { "type": ["string", "null"] },
          "AccessKeyIds": { "type": "array", "items": { "type": "string" } },
          "MFADevices": { "type": "array", "items": { "type": "string" } },
          "Groups": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["UserName"]
      }
    },

    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "RoleName": { "type": "string" },
          "Arn": { "type": ["string", "null"] },
          "AssumeRolePolicyDocument": { "type": "object" },
          "AttachedPolicies": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["RoleName", "AssumeRolePolicyDocument"]
      }
    },

    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "GroupName": { "type": "string" },
          "Members": { "type": "array", "items": { "type": "string" } },
          "AttachedPolicies": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["GroupName"]
      }
    },

    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "PolicyName": { "type": "string" },
          "Document": { "type": "object" },
          "Checksum": { "type": ["string", "null"] }
        },
        "required": ["PolicyName", "Document"]
      }
    },

    "trust_relationships": {
      "type": "array",
      "$comment": "Duplicate of account-level trust, but centralized here for very large orgs.",
      "items": {
        "type": "object",
        "properties": {
          "RoleName": { "type": "string" },
          "AssumeRolePolicyDocument": { "type": "object" },
          "TrustedEntities": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["RoleName", "AssumeRolePolicyDocument"]
      }
    }
  },
  "required": ["meta"],
  "additionalProperties": false
}
