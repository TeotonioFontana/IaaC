{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iaac-recovery-suite/json_schemas/environment_manifest_schema.json",
  "title": "Environment Manifest Schema",
  "description": "Captures human and logical context of the backup environment (IaC states, dependencies, operator notes).",
  "$comment": "This manifest preserves the operational context — the mental model behind the backup. It bridges human processes and machine reproducibility.",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "string" },
        "owner": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["schema_version", "owner"]
    },
    "Workloads": {
      "type": "array",
      "$comment": "Logical applications mapped to underlying infrastructure objects.",
      "items": {
        "type": "object",
        "properties": {
          "Name": { "type": "string" },
          "Resources": { "type": "array", "items": { "type": "string" } },
          "Owner": { "type": ["string", "null"] },
          "Priority": { "type": ["string", "null"] }
        },
        "required": ["Name", "Resources"]
      }
    },
    "IaC": {
      "type": "object",
      "$comment": "Infrastructure-as-Code fingerprints (Terraform/CloudFormation).",
      "properties": {
        "TemplateHash": { "type": "string" },
        "CommitId": { "type": "string" },
        "Repository": { "type": "string" }
      }
    },
    "Dependencies": {
      "type": "array",
      "$comment": "Software or data dependencies referenced by workloads.",
      "items": { "type": "string" }
    },
    "OperatorNotes": { "type": "string" },
    "RecoveryChecklistVersion": { "type": "string" }
  },
  "required": ["meta"],
  "additionalProperties": false
}
